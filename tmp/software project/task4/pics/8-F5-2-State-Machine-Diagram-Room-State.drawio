<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/28.2.8 Chrome/140.0.7339.240 Electron/38.4.0 Safari/537.36" version="28.2.8">
  <diagram name="State Machine Diagram: Room State" id="state-machine-room">
    <mxGraphModel dx="969" dy="710" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" value="Start" style="shape=triangle;perimeter=trianglePerimeter;direction=east;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=14;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="260" y="120" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="end" value="End" style="shape=ellipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;fontSize=14;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="770" y="395" width="80" height="50" as="geometry" />
        </mxCell>
        <mxCell id="state-not-exists" value="Room does not exist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="220" y="230" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="state-open" value="Open Room&#xa;(No Password)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="220" y="380" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="state-password-protected" value="Password Protected Room" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=12;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="220" y="530" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="state-empty" value="Empty Room&#xa;(Pending Reset)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;fontSize=12;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="500" y="380" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="transition-start-not-exists" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#000000" parent="1" source="start" target="state-not-exists" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="300" y="210" />
              <mxPoint x="300" y="210" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="transition-not-exists-open" value="First user joins&#xa;ensureRoom()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#000000;fontSize=10" parent="1" source="state-not-exists" target="state-open" edge="1">
          <mxGeometry x="-0.1429" y="-10" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="300" y="290" />
              <mxPoint x="300" y="420" />
            </Array>
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="transition-open-password" value="Creator sets password&#xa;updateRoom(password)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#000000;fontSize=10" parent="1" source="state-open" target="state-password-protected" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="300" y="460" />
              <mxPoint x="300" y="600" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="transition-password-open" value="Creator removes password&#xa;updateRoom(password=null)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#000000;fontSize=10" parent="1" source="state-password-protected" target="state-open" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="300" y="600" />
              <mxPoint x="300" y="460" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="transition-open-empty" value="All users leave&#xa;removeUserImmediate()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#000000;fontSize=10" parent="1" source="state-open" target="state-empty" edge="1">
          <mxGeometry y="-20" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="transition-password-empty" value="All users leave&#xa;removeUserImmediate()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#000000;fontSize=10" parent="1" source="state-password-protected" target="state-empty" edge="1">
          <mxGeometry x="-0.2353" y="20" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="580" y="550" />
            </Array>
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="transition-empty-open" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;New user joins empty room&lt;br&gt;clearMessagesForRoom()&lt;br&gt;updateRoom(password=null, creatorSession=null)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#CC6600;fontSize=9" parent="1" edge="1">
          <mxGeometry y="-30" relative="1" as="geometry">
            <mxPoint x="500" y="390" as="sourcePoint" />
            <mxPoint x="380" y="390" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="transition-password-password" value="Modify password&#xa;clearMessagesForRoom()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#CC6600;fontSize=10;entryX=1;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.75;exitDx=0;exitDy=0;" parent="1" source="state-password-protected" target="state-password-protected" edge="1">
          <mxGeometry x="0.0313" y="-70" relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="430" y="590" />
              <mxPoint x="430" y="571" />
              <mxPoint x="380" y="571" />
            </Array>
            <mxPoint x="400" y="580" as="sourcePoint" />
            <mxPoint x="430" y="580" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="transition-empty-end" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;Delayed cleanup timeout&amp;nbsp;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;(3 minutes)&lt;br&gt;removeUserImmediate()&lt;/font&gt;&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeWidth=2;strokeColor=#CC0000;fontSize=9" parent="1" source="state-empty" target="end" edge="1">
          <mxGeometry x="0.0909" y="40" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="note-legend" value="State Description:&#xa;• Room does not exist: System initialization or room never created&#xa;• Open Room: No password protection, any user can join&#xa;• Password Protected Room: Password required to join&#xa;• Empty Room: Immediately enters this state after all users leave&#xa;&#xa;Key Transitions:&#xa;• Empty Room Reset: When new user joins empty room, automatically clear messages and password, reset to open room&#xa;• Delayed Cleanup: After empty room state persists for 3 minutes, system cleans up room state (end)&#xa;• Modify Password: When password protected room modifies password, chat history is cleared" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#000000;fontSize=10" parent="1" vertex="1">
          <mxGeometry x="400" y="150" width="450" height="160" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
